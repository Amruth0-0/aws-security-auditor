# ============================================================================
# Local development environment. Copy to .env (gitignored) and fill in:
#
#   cp .env.example .env
#   cd terraform && terraform output
#
# Loaded by the npm scripts via Node 20's built-in --env-file-if-exists, so
# there is no dotenv dependency.
#
# Because src/config/env.js validates LAZILY, you only need the variables the
# script you are running actually touches. runLocalScan.js saves findings but
# does not publish alerts, so SNS_TOPIC_ARN can stay commented out for it.
# ============================================================================

# Required by anything that reads or writes findings (findingsRepo.js)
FINDINGS_TABLE_NAME=chainbreak-findings

# Required only by src/notify/alerts.js.
# Get it with: terraform output sns_topic_arn
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:chainbreak-alerts

# Optional. Region the SDK should use; falls back to us-east-1 in env.js.
# AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# Phase 7 — remediation
# ----------------------------------------------------------------------------
# Anything other than the literal string "true" leaves remediation in dry-run
# mode. Leave this unset locally unless you specifically want to test a real
# revoke against a throwaway security group.
# REMEDIATION_ENABLED=false

# Must be valid JSON. Both lists must be non-empty or nothing is remediated.
# REMEDIATION_WHITELIST={"ports":[22,3389],"cidrs":["0.0.0.0/0"]}

# Comma-separated security group IDs the auditor must never touch.
# EXCLUDED_SG_IDS=sg-0123456789abcdef0,sg-0fedcba9876543210

# ----------------------------------------------------------------------------
# Phase 8 — scoring
# ----------------------------------------------------------------------------
# Blast radius score at which a finding is escalated instead of auto-fixed.
# Defaults to 12 inside blastRadius.js when unset.
# SEVERITY_THRESHOLD=12
