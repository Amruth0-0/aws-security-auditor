{
  "name": "aws-security-auditor",
  "version": "1.0.0",
  "main": "src/handler.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "node --env-file-if-exists=.env test/local/runLocalScan.js",
    "test:repo": "node --env-file-if-exists=.env test/local/testFindingsRepo.js",
    "test:gsi": "node --env-file-if-exists=.env test/local/testGetByStatus.js"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "description": "Automated AWS security auditor that traces attack paths across resources, auto-remediates low-risk findings and escalates high-blast-radius ones.",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1114.0",
    "@aws-sdk/client-ec2": "^3.1111.0",
    "@aws-sdk/client-iam": "^3.1162.0",
    "@aws-sdk/client-rds": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sns": "^3.1114.0",
    "@aws-sdk/lib-dynamodb": "^3.1114.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
